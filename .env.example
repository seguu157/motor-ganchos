# Copia este archivo a .env y rellena solo lo que vayas a usar.
# Sin APIFY_TOKEN la app arranca igual y muestra los datos de ejemplo.
# En modo auto, sin token, la tanda real cae a Instaloader (0 USD) si hay sesión.

# --- Base de datos ---
# RADAR_DB=./data/radar.sqlite

# --- Apify (actor apify/instagram-reel-scraper) ---
APIFY_TOKEN=
# Precio de referencia del plan Free, en USD por cada 1.000 reels.
# Fuente: ficha pública del actor (pago por resultado). Cámbialo si Apify
# actualiza la tarifa. La app solo estima: no consulta tu saldo.
APIFY_USD_PER_1000=2.60
APIFY_MONTHLY_CREDIT_USD=5.00
# Reels recientes pedidos por cuenta. El valor de trabajo es 20.
RADAR_REELS_PER_ACCOUNT=20

# Fuente: auto (Apify si hay token y el coste cabe; si no, Instaloader),
# apify o instaloader.
RADAR_SOURCE=auto

# --- Instaloader (respaldo, 0 USD) ---
# Cuenta secundaria. No pongas aquí la contraseña: `radar ig-login` la pide
# en la terminal y solo guarda la sesión. Instagram puede limitar esa cuenta.
# Si el VPS sale bloqueado, lanza la tanda desde una IP residencial.
IG_USERNAME=
IG_SESSION_FILE=data/ig.session
# Máximo de cuentas por tanda con Instaloader. Por defecto 10.
RADAR_IG_MAX_ACCOUNTS=10

# Un outlier es un reel con reproducciones >= este múltiplo de la mediana.
RADAR_OUTLIER_MULTIPLE=2

# --- Transcripción local (solo outliers) ---
# Modelo small en CPU e int8: pensado para un VPS de unos 2 GB.
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=es

# --- Análisis con LLM (opcional) ---
# openai: cualquier API compatible (OpenAI, xAI, OpenRouter, etc.)
# anthropic: API de Anthropic
# none: no analiza
LLM_PROVIDER=none
LLM_MODEL=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=

# Ejemplo orientativo con la API compatible de xAI (revisa el nombre del modelo vigente):
# LLM_PROVIDER=openai
# OPENAI_BASE_URL=https://api.x.ai/v1
# OPENAI_API_KEY=
# LLM_MODEL=

# --- TubeAlfred (YouTube) ---
# Reservada. El adaptador está vacío y desactivado: definir la clave no llama a nadie.
TUBEALFRED_API_KEY=

# --- Interfaz ---
RADAR_HOST=127.0.0.1
RADAR_PORT=8000
