# Copia este archivo a .env y rellena solo lo que vayas a usar.
# Sin APIFY_TOKEN la app arranca igual y muestra los datos de ejemplo.
# La fuente por defecto es el navegador (`radar login`). No guarda la contraseña.

# --- Base de datos ---
# RADAR_DB=./data/radar.sqlite

# --- Apify (actor apify/instagram-reel-scraper) ---
APIFY_TOKEN=
# Precio de referencia del plan Free, en USD por cada 1.000 reels.
# Fuente: ficha pública del actor (pago por resultado). Cámbialo si Apify
# actualiza la tarifa. La app solo estima: no consulta tu saldo.
APIFY_USD_PER_1000=2.60
APIFY_MONTHLY_CREDIT_USD=5.00
# Reels recientes pedidos por cuenta. El valor de trabajo es 20.
RADAR_REELS_PER_ACCOUNT=20

# Fuente por defecto: playwright (navegador). Alternativas: apify, instaloader.
# auto usa el navegador si ya hay sesión; si no, Apify cuando hay token y el
# coste cabe; si no, Instaloader.
RADAR_SOURCE=playwright

# --- Navegador (fuente por defecto, 0 USD) ---
# `radar login` abre Chromium. La contraseña la escribes tú en la ventana.
# El scraping con sesión va contra las condiciones de Instagram y puede
# bloquear la cuenta secundaria. Usa una cuenta que no sea la de publicar.
IG_BROWSER_PROFILE=data/ig-browser
RADAR_BROWSER_MAX_ACCOUNTS=5
RADAR_BROWSER_MAX_POSTS=20
RADAR_BROWSER_PAUSE_ACCOUNT=25-70
RADAR_BROWSER_PAUSE_POST=3-8
# Un comentario cuenta como estos me gusta al puntuar carruseles.
RADAR_COMMENT_WEIGHT=4

# --- Instaloader (respaldo, 0 USD) ---
# Cuenta secundaria. No pongas aquí la contraseña: `radar ig-login` la pide
# en la terminal y solo guarda la sesión. Instagram puede limitar esa cuenta.
# Si el VPS sale bloqueado, lanza la tanda desde una IP residencial.
IG_USERNAME=
IG_SESSION_FILE=data/ig.session
# Máximo de cuentas por tanda con Instaloader. Por defecto 10.
RADAR_IG_MAX_ACCOUNTS=10

# Un outlier es un reel con reproducciones >= este múltiplo de la mediana.
RADAR_OUTLIER_MULTIPLE=2

# --- Transcripción local (solo outliers) ---
# Modelo small en CPU e int8: pensado para un VPS de unos 2 GB.
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=es

# --- Análisis con LLM ---
# Sin clave de API el valor por defecto es codex: usa la suscripción de ChatGPT
# (Plus/Pro) a través de Codex CLI, no una API de pago.
# RADAR_LLM=codex
# Modelo opcional de Codex. Si lo omites, vale el de `codex login`.
# RADAR_CODEX_MODEL=
# Pausa en segundos entre reels, para no chocar con el límite del plan.
RADAR_LLM_DELAY_SECONDS=2

# Para volver a una clave de API:
# RADAR_LLM=openai
# LLM_MODEL=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# RADAR_LLM=anthropic
# ANTHROPIC_API_KEY=
# RADAR_LLM=none
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
LLM_MODEL=

# --- TubeAlfred (YouTube) ---
# Reservada. El adaptador está vacío y desactivado: definir la clave no llama a nadie.
TUBEALFRED_API_KEY=

# --- Interfaz ---
RADAR_HOST=127.0.0.1
RADAR_PORT=8000
